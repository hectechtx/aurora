{
  "name": "Decision Matrix",
  "version": "1.0.0",
  "description": "Scores multiple options against weighted criteria to support a structured decision.",
  "entrypoint": "index.js",
  "risk": "low",
  "tools": [
    {
      "name": "score_decision_matrix",
      "description": "Scores options against weighted criteria and ranks them best first.",
      "parameters": {
        "type": "object",
        "properties": {
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "weight": {
                  "type": "number"
                }
              }
            }
          },
          "scores": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "required": [
          "options",
          "criteria",
          "scores"
        ]
      },
      "risk": "low"
    }
  ],
  "category": "Business & Finance"
}
